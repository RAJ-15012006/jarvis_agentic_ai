# JARVIS Environment Configuration

# Groq API Key (Required for routing and chat agents)
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key (Required for weather updates)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NewsAPI Key (Required for morning news summaries)
NEWS_API_KEY=your_news_api_key_here

# WebSocket Token Authentication (Ensure this matches frontend token)
SOCKET_SECRET=jarvis-local-secret

# Spotify Developer API Settings
# Register your app at: https://developer.spotify.com/dashboard
# Add Redirect URI: http://localhost:8888/callback in your Spotify App Dashboard settings!
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# GitHub API Configuration
# Optional: Add a Personal Access Token (PAT) to check private repositories
GITHUB_TOKEN=your_github_token_here
